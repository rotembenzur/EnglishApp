{
  "name": "lexbites",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "LexBites: personal English vocabulary trainer PWA for rotem and noa",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "tsx scripts/icons.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "enrich": "tsx scripts/enrich.ts",
    "reports": "tsx scripts/reports.ts",
    "audio:plan": "tsx scripts/audio/plan.ts",
    "prepare": "husky",
    "content:fetch": "bash scripts/fetch-data.sh",
    "content:lemmas": "scripts/.cache/venv/bin/python -I scripts/build_lemmas.py",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bidi-js": "1.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "http_ece": "1.2.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "web-push": "^3.6.7",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
