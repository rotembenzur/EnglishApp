{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lexbites.app/schema/shard.json",
  "title": "LexBites Tier A shard",
  "description": "An array of up to 200 fully authored lemma entries, in frequency order.",
  "type": "array",
  "maxItems": 200,
  "items": {
    "$ref": "#/definitions/entry"
  },
  "definitions": {
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "he"],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 8,
          "maxLength": 220
        },
        "he": {
          "type": "string",
          "minLength": 4,
          "maxLength": 260
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lemma", "pos", "ipa", "hebrew", "definition", "sentences", "tier"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "lemma": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "pos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "enum": [
              "noun",
              "verb",
              "adj",
              "adv",
              "prep",
              "conj",
              "pron",
              "det",
              "aux",
              "interj",
              "num",
              "other"
            ]
          }
        },
        "ipa": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^/.+/$"
        },
        "ipaUk": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^/.+/$"
        },
        "hebrew": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "definition": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "sentences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/sentence"
          }
        },
        "collocations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          }
        },
        "hook": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "context": {
          "$ref": "#/definitions/paragraph"
        },
        "tags": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "enum": [
              "family",
              "work",
              "travel",
              "food",
              "tech",
              "emotions",
              "health",
              "nature",
              "law",
              "finance",
              "academic",
              "slang",
              "everyday",
              "media"
            ]
          }
        },
        "tier": {
          "const": "A"
        },
        "forms": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[A-Za-z' -]+$"
          },
          "description": "Irregular or notable inflected forms used in sentences (went, gone, children)."
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "he"],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 40,
          "maxLength": 600
        },
        "he": {
          "type": "string",
          "minLength": 30,
          "maxLength": 700
        }
      }
    }
  }
}
